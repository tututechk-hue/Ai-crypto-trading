{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/startup.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/startup.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/startup.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev --name init",
    "seed": "node dist/prisma/seed.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js"
  },
  "dependencies": {
    "@prisma/client": "4.15.0",
    "axios": "^1.4.0",
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "ws": "^8.13.0",
    "nodemailer": "^6.9.4"
  },
  "devDependencies": {
    "prisma": "4.15.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "5.2.2"
  }
}
